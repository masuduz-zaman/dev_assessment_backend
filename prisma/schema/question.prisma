model Question {
  id           String       @id @default(cuid())
  assessmentId String
  type         QuestionType
  prompt       String
  marks        Float
  order        Int          @default(0)
  explanation  String?

  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options      QuestionOption[]
  submissions  Submission[]
  codingConfig CodingConfig?
}
