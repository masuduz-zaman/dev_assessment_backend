NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/assessment_platform?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

# ---- Google social login (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
# Add http://localhost:3000 to "Authorized JavaScript origins". Use the SAME client id in frontend/.env.local
GOOGLE_CLIENT_ID=

# ---- Payments: choose ONE provider. Credentials are the provider's sandbox/test credentials (real gateway, no fake payments)
PAYMENT_PROVIDER=sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- File storage (leave Cloudinary empty to use local disk in development)
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Coding execution is delegated to an isolated Judge0-compatible service, never run on this server
JUDGE0_BASE_URL=
JUDGE0_API_KEY=

# ---- Seeded demo accounts (used by `npm run db:seed`)
SEED_ADMIN_NAME=Platform Super Admin
SEED_ADMIN_EMAIL=admin@demo.test
SEED_ADMIN_PASSWORD=Demo1234!
SEED_COMPANY_EMAIL=company@demo.test
SEED_COMPANY_PASSWORD=Demo1234!
SEED_CANDIDATE_EMAIL=candidate@demo.test
SEED_CANDIDATE_PASSWORD=Demo1234!
# When true, GET /api/auth/demo-accounts lists the seeded demo credentials on the login page. Keep false in real production.
EXPOSE_DEMO_ACCOUNTS=true
